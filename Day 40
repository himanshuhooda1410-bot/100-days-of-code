
#include <stdio.h>

int main() {
    int r, c, i, j, k;

    printf("Enter number of rows: ");
    scanf("%d", &r);

    printf("Enter number of columns: ");
    scanf("%d", &c);

    int a[r][c];

    printf("Enter matrix elements:\n");

    for(i = 0; i < r; i++) {
        for(j = 0; j < c; j++) {
            scanf("%d", &a[i][j]);
        }
    }

    printf("Diagonal traversal:\n");

    // Start from each column of first row
    for(k = 0; k < c; k++) {
        i = 0;
        j = k;

        while(i < r && j >= 0) {
            printf("%d ", a[i][j]);
            i++;
            j--;
        }
    }

    // Start from remaining rows of last column
    for(k = 1; k < r; k++) {
        i = k;
        j = c - 1;

        while(i < r && j >= 0) {
            printf("%d ", a[i][j]);
            i++;
            j--;
        }
    }

    return 0;
}

