
#include <stdio.h>

int main() {
    char date[20];
    char day[3], month[3], year[5];

    printf("Enter date (dd/04/yyyy): ");
    scanf("%19s", date);

    sscanf(date, "%2[^/]/%2[^/]/%4s", day, month, year);

    if (month[0] == '0' && month[1] == '4') {
        printf("%s-Apr-%s", day, year);
    } else {
        printf("Invalid month");
    }

    return 0;
}

