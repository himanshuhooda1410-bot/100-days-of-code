
#include <stdio.h>

int main() {
    FILE *fp;
    char filename[50];
    int ch;

    printf("Enter filename: ");
    scanf("%49s", filename);

    fp = fopen(filename, "r");

    if (fp == NULL) {
        printf("Error: File does not exist!");
        return 1;
    }

    printf("File exists!\n");
    printf("File contents:\n");

    while ((ch = fgetc(fp)) != EOF) {
        putchar(ch);
    }

    fclose(fp);

    return 0;
}
