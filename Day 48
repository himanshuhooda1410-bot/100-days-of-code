
#include <stdio.h>

int main() {
    char a[500], b[500];
    char temp[1000];
    int n = 0, m = 0, found = 0;

    scanf("%499s %499s", a, b);

    while (a[n] != '\0') n++;
    while (b[m] != '\0') m++;

    if (n == m) {
        for (int i = 0; i < n; i++) {
            temp[i] = a[i];
            temp[n + i] = a[i];
        }
        temp[2 * n] = '\0';

        if (n == 0)
            found = 1;

        for (int i = 0; i <= n && !found; i++) {
            int j = 0;

            while (j < n && temp[i + j] == b[j]) {
                j++;
            }

            if (j == n)
                found = 1;
        }
    }

    if (found)
        printf("Rotation\n");
    else
        printf("Not Rotation\n");

    return 0;
}

