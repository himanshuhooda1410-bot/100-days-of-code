
#include <stdio.h>

int main() {
    char str[1000], ch;
    int count = 0;

    fgets(str, sizeof(str), stdin);
    scanf(" %c", &ch);

    for (int i = 0; str[i] != '\0' && str[i] != '\n'; i++) {
        if (str[i] == ch) {
            count++;
        }
    }

    printf("Frequency = %d\n", count);

    return 0;
}

