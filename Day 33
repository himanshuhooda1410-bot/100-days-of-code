#include <stdio.h>

int main() {
    int n, i, num, pos;

    printf("Enter size of array: ");
    scanf("%d", &n);

    int arr[n + 1];

    printf("Enter sorted array elements:\n");
    for(i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    printf("Enter element to insert: ");
    scanf("%d", &num);

    pos = n;

    // Find correct position
    for(i = 0; i < n; i++) {
        if(arr[i] > num) {
            pos = i;
            break;
        }
    }

    // Shift elements to the right
    for(i = n; i > pos; i--) {
        arr[i] = arr[i - 1];
    }

    arr[pos] = num;

    printf("Array after insertion:\n");

    for(i = 0; i <= n; i++) {
        printf("%d ", arr[i]);
    }

    return 0;
}
