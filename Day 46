#include <stdio.h>

int main() {
    char str[1000];
    int seen[26] = {0};
    int found = 0;

    fgets(str, sizeof(str), stdin);

    for (int i = 0; str[i] != '\0' && str[i] != '\n'; i++) {
        if (str[i] >= 'a' && str[i] <= 'z') {
            int index = str[i] - 'a';

            if (seen[index]) {
                printf("%c\n", str[i]);
                found = 1;
                break;
            }

            seen[index] = 1;
        }
    }

    if (!found) {
        printf("-1\n");
    }

    return 0;
}
