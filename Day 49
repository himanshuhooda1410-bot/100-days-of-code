#include <stdio.h>
#include <string.h>

int main() {
    char name[100];
    int start = 0, lastSpace = -1;

    printf("Enter your name: ");
    fgets(name, sizeof(name), stdin);

    int len = strlen(name);

    if (len > 0 && name[len - 1] == '\n') {
        name[len - 1] = '\0';
        len--;
    }

    for (int i = 0; i < len; i++) {
        if (name[i] == ' ') {
            lastSpace = i;
        }
    }

    for (int i = 0; i < len; i++) {
        if (i == 0 && name[i] != ' ') {
            printf("%c.", name[i]);
        }
        else if (name[i] == ' ' && i < lastSpace) {
            if (name[i + 1] != ' ') {
                printf("%c.", name[i + 1]);
            }
        }
    }

    if (lastSpace != -1) {
        printf(" %s", name + lastSpace + 1);
    } else {
        printf("%s", name);
    }

    return 0;
}
