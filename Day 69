
#include <stdio.h>
#include <stdlib.h>

int main() {
    int n;
    scanf("%d", &n);

    int arr[n];

    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    int *visited = calloc(n, sizeof(int));

    for (int i = 0; i < n; i++) {

        if (visited[arr[i]] == 1) {
            printf("%d", arr[i]);
            free(visited);
            return 0;
        }

        visited[arr[i]] = 1;
    }

    printf("-1");

    free(visited);

    return 0;
}
