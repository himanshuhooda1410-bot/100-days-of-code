   scanf("%c", &ch);
 
   if (ch == 'a' || ch == 'e' || ch == 'i' ||// condtion to check whether the input character is a vowel
       ch == 'o' || ch == 'u' ||
       ch == 'A' || ch == 'E' || ch == 'I' ||
       ch == 'O' || ch == 'U')
   {
       printf("Vowel\n");  // printing if the character is a vowel
   }
