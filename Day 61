
#include <stdio.h>

int main() {
    int n, k;
    scanf("%d", &n);

    int arr[n];

    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    scanf("%d", &k);

    if (k <= 0 || k > n)
        return 0;

    for (int i = 0; i <= n - k; i++) {
        int ans = 0;

        for (int j = i; j < i + k; j++) {
            if (arr[j] < 0) {
                ans = arr[j];
                break;
            }
        }

        printf("%d ", ans);
    }

    return 0;
}
