#include <stdio.h>

int main() {
    int r, c, i, j, sum = 0;

    printf("Enter number of rows: ");
    scanf("%d", &r);

    printf("Enter number of columns: ");
    scanf("%d", &c);

    int arr[r][c];

    printf("Enter matrix elements:\n");

    // Read matrix elements
    for(i = 0; i < r; i++) {
        for(j = 0; j < c; j++) {
            scanf("%d", &arr[i][j]);
        }
    }

    // Calculate sum
    for(i = 0; i < r; i++) {
        for(j = 0; j < c; j++) {
            sum = sum + arr[i][j];
        }
    }

    printf("Sum of all elements = %d", sum);

    return 0;
}
