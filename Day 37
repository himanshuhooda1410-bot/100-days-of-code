#include <stdio.h>

int main() {
    int r, c, i, j;

    printf("Enter number of rows: ");
    scanf("%d", &r);

    printf("Enter number of columns: ");
    scanf("%d", &c);

    int arr[r][c];
    int trans[c][r];

    printf("Enter matrix elements:\n");

    // Read matrix
    for(i = 0; i < r; i++) {
        for(j = 0; j < c; j++) {
            scanf("%d", &arr[i][j]);
        }
    }

    // Find transpose
    for(i = 0; i < r; i++) {
        for(j = 0; j < c; j++) {
            trans[j][i] = arr[i][j];
        }
    }

    // Print transpose
    printf("Transpose of matrix:\n");

    for(i = 0; i < c; i++) {
        for(j = 0; j < r; j++) {
            printf("%d ", trans[i][j]);
        }
        printf("\n");
    }

    return 0;
}
