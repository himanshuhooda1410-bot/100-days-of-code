
#include <stdio.h>

int main() {
    int r, c, i, j;

    printf("Enter number of rows: ");
    scanf("%d", &r);

    printf("Enter number of columns: ");
    scanf("%d", &c);

    int arr[r][c];
    int sum[r];

    printf("Enter matrix elements:\n");

    // Read matrix
    for(i = 0; i < r; i++) {
        for(j = 0; j < c; j++) {
            scanf("%d", &arr[i][j]);
        }
    }

    // Calculate sum of each row
    for(i = 0; i < r; i++) {
        sum[i] = 0;

        for(j = 0; j < c; j++) {
            sum[i] = sum[i] + arr[i][j];
        }
    }

    // Print row sums
    printf("Sum of each row:\n");

    for(i = 0; i < r; i++) {
        printf("Row %d = %d\n", i + 1, sum[i]);
    }

    return 0;
}
