
#include <stdio.h>

int main() {
    int n;
    scanf("%d", &n);

    int arr[n];
    long long totalSum = 0;

    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
        totalSum += arr[i];
    }

    long long leftSum = 0;
    int ans = -1;

    for (int i = 0; i < n; i++) {
        long long rightSum = totalSum - leftSum - arr[i];

        if (leftSum == rightSum) {
            ans = i;
            break;
        }

        leftSum += arr[i];
    }

    printf("%d", ans);

    return 0;
}

