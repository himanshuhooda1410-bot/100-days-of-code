
#include <stdio.h>
#include <ctype.h>

int main() {
    FILE *fp;
    char filename[50];
    int ch, characters = 0;
    int words = 0, lines = 0;
    int inWord = 0, lastChar = '\0';

    printf("Enter filename: ");
    scanf("%49s", filename);

    fp = fopen(filename, "r");

    if (fp == NULL) {
        printf("File not found!");
        return 1;
    }

    while ((ch = fgetc(fp)) != EOF) {
        characters++;
        lastChar = ch;

        if (ch == '\n')
            lines++;

        if (isspace((unsigned char)ch)) {
            inWord = 0;
        } else if (!inWord) {
            words++;
            inWord = 1;
        }
    }

    if (characters > 0 && lastChar != '\n')
        lines++;

    fclose(fp);

    printf("Characters = %d\n", characters);
    printf("Words = %d\n", words);
    printf("Lines = %d\n", lines);

    return 0;
}
