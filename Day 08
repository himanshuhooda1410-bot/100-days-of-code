//Q15: Write a program to input three numbers and find the largest among them using if–else.

#include<stdio.h>
int main()
{
    int a,b,c;  

    printf("input the first number:\n"); 
    scanf("%d",&a);

    printf("input the second number:\n");
    scanf("%d",&b);

    printf("input the third number:\n");
    scanf("%d",&c);

    if(a>b||a>c)  // condition for checkin if the first number is the greatest number
    {
        printf("%d is the greatest number\n",a);  // printing if the first number is the greatest number
    }
    else if(b>a||b>c)  // condition to check if the second number is the greatest number
    {
        printf("%d is the greatest number\n",b);   // printing if the second number is the greatest number

    }
    else
    {
        printf("%d is the greatest number\n",c);   // printing if the third number is the greatest
    }
}



//Q16: Write a program to input a character and check whether it is an uppercase alphabet, lowercase alphabet, digit, or special character.

#include <stdio.h>

int main()
 {
    char ch;
    printf("Enter any character: ");
    scanf("%c", &ch); 

    if (ch >= 'A' && ch <= 'Z')  // condition to check if the character is uppercase
    {
        printf("'%c' is an uppercase alphabet.\n", ch);  
    } 
    else if (ch >= 'a' && ch <= 'z')   //  condition to check if the character is lowercase
    {
        printf("'%c' is a lowercase alphabet.\n", ch);
    } 
    else if (ch >= '0' && ch <= '9')   // condition to check if the character is a digit
    {
    
        printf("'%c' is a digit.\n", ch); 
    } 
    else 
    {
        printf("'%c' is a special character.\n", ch); 
    }return 0;
}
