
#include <stdio.h>

int main() {
    int n, target;
    scanf("%d", &n);

    int nums[n];

    for (int i = 0; i < n; i++)
        scanf("%d", &nums[i]);

    scanf("%d", &target);

    int first = -1, last = -1;
    int low = 0, high = n - 1;

    // First occurrence
    while (low <= high) {
        int mid = low + (high - low) / 2;

        if (nums[mid] >= target) {
            if (nums[mid] == target)
                first = mid;
            high = mid - 1;
        } else {
            low = mid + 1;
        }
    }

    // Last occurrence
    low = 0;
    high = n - 1;

    while (low <= high) {
        int mid = low + (high - low) / 2;

        if (nums[mid] <= target) {
            if (nums[mid] == target)
                last = mid;
            low = mid + 1;
        } else {
            high = mid - 1;
        }
    }

    printf("%d, %d", first, last);

    return 0;
}


