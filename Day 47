#include <stdio.h>
#include <ctype.h>

int main() {
    char str[1000];
    char longest[1000];
    int maxLen = 0, len = 0, start = 0;

    fgets(str, sizeof(str), stdin);

    for (int i = 0; ; i++) {
        if (str[i] != '\0' && !isspace((unsigned char)str[i])) {
            len++;
        }
        else {
            if (len > maxLen) {
                maxLen = len;

                for (int j = 0; j < len; j++) {
                    longest[j] = str[start + j];
                }

                longest[len] = '\0';
            }

            if (str[i] == '\0')
                break;

            len = 0;
            start = i + 1;
        }
    }

    if (maxLen > 0)
        printf("Longest word = %s\n", longest);
    else
        printf("No word found\n");

    return 0;
}
