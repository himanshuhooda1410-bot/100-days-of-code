
#include <stdio.h>
#include <ctype.h>

int main() {
    char a[1000], b[1000];
    int freq[256] = {0};
    int flag = 1;

    fgets(a, sizeof(a), stdin);
    fgets(b, sizeof(b), stdin);

    for (int i = 0; a[i] != '\0'; i++) {
        unsigned char ch = (unsigned char)a[i];

        if (ch != ' ' && ch != '\n') {
            freq[tolower(ch)]++;
        }
    }

    for (int i = 0; b[i] != '\0'; i++) {
        unsigned char ch = (unsigned char)b[i];

        if (ch != ' ' && ch != '\n') {
            freq[tolower(ch)]--;
        }
    }

    for (int i = 0; i < 256; i++) {
        if (freq[i] != 0) {
            flag = 0;
            break;
        }
    }

    if (flag)
        printf("Anagrams\n");
    else
        printf("Not Anagrams\n");

    return 0;
}

