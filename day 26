#include <stdio.h>

int main()
{
    int i, j, count;

    for(i = 1; i <= 5; i++)
    {
        if(i == 1 || i == 5)
            count = 1;
        else if(i == 2 || i == 4)
            count = 3;
        else
            count = 5;

        for(j = 1; j <= count; j++)
        {
            printf("*\n");
        }

        printf("\n");
    }

    return 0;
}