#include <stdio.h>

int main()
{
    int n, first, last, temp, digits = 1, divisor = 1, result;

    printf("Enter a number: ");
    scanf("%d", &n);

    temp = n;

    last = temp % 10;

    while (temp >= 10)
    {
        temp = temp / 10;
        digits++;
    }

    first = temp;

    for (int i = 1; i < digits; i++)
    {
        divisor = divisor * 10;
    }

    result = last * divisor + (n % divisor) / 10 * 10 + first;

    printf("Number after swapping: %d", result);

    return 0;
}


