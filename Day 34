
#include <stdio.h>

int main() {
    int n, i, num, pos;

    printf("Enter size of array: ");
    scanf("%d", &n);

    int arr[n + 1];

    printf("Enter array elements:\n");
    for(i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    printf("Enter element to insert: ");
    scanf("%d", &num);

    printf("Enter position: ");
    scanf("%d", &pos);

    if(pos < 1 || pos > n + 1) {
        printf("Invalid position");
        return 0;
    }

    // Shift elements to the right
    for(i = n; i >= pos; i--) {
        arr[i] = arr[i - 1];
    }

    arr[pos - 1] = num;

    printf("Array after insertion:\n");

    for(i = 0; i <= n; i++) {
        printf("%d ", arr[i]);
    }

    return 0;
}

